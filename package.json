{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "description": "3D office that turns Antigravity App conversations into employees",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/main.ts --no-open\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "test": "vitest run && bash scripts/check-guards.sh",
    "test:e2e": "playwright test",
    "test:live": "AGENT_OFFICE_LIVE=1 vitest run",
    "test:leaks": "vitest run tests/leaks",
    "bench:fps": "tsx scripts/bench-fps.ts",
    "check:compat": "tsx scripts/check-compat.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "env-paths": "^4.0.0",
    "fastify": "^5.12.8",
    "open": "^11.0.4",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
